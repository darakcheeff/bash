#!/bin/bash

# Проверка аргументов
if [ "$#" -ne 1 ]; then
    echo "Использование: $0 <файл.txt>"
    exit 1
fi

FILE=$1
if [ ! -f "$FILE" ]; then
    echo "Файл не найден: $FILE"
    exit 1
fi

# Настройки
WORDS_PER_MINUTE=300  # Скорость (слов/мин)
ORP_COLOR='\e[31m'    # Красный цвет для ORP (теперь используется \e вместо \033)
RESET_COLOR='\e[0m'   # Сброс цвета

# Рассчитываем задержку между словами (в секундах)
DELAY=$(echo "scale=3; 60 / $WORDS_PER_MINUTE" | bc)

# Функция для вычисления ORP
get_orp_position() {
    local word=$1
    local length=${#word}
    
    if (( length <= 3 )); then
        echo 0
    elif (( length <= 7 )); then
        echo $(( length / 3 ))
    else
        echo 3
    fi
}

# Очищаем экран и прячем курсор
clear
tput civis

# Читаем файл и выводим слова с ORP-подсветкой
while read -r line; do
    words=($line)
    for word in "${words[@]}"; do
        orp_pos=$(get_orp_position "$word")
        before_orp="${word:0:orp_pos}"
        orp_char="${word:orp_pos:1}"
        after_orp="${word:orp_pos+1}"
        
        # Центрируем вывод
        cols=$(tput cols)
        padding=$(( (cols - ${#word}) / 2 ))
        printf "%*s" $padding ""
        
        # Выводим слово с цветом (теперь через echo -e)
        echo -en "${before_orp}${ORP_COLOR}${orp_char}${RESET_COLOR}${after_orp}"
        
        sleep $DELAY
        clear
    done
done < "$FILE"

# Восстанавливаем курсор
tput cnorm
